# Copy to .env and fill in. Never commit .env.

# Local default is SQLite. For Neon use:
# postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Any OpenAI-compatible chat completions API works.
# Default below points at Mistral. Prices are per 1M tokens.
LLM_BASE_URL=https://api.mistral.ai/v1
LLM_API_KEY=
LLM_MODEL=mistral-small-latest
LLM_PRICE_IN=0.10
LLM_PRICE_OUT=0.30

# --- Email -------------------------------------------------------------
# console: print emails to the server log (default; no credentials needed)
# mailgun: Mailgun HTTP API (what Squarespace uses)
# smtp:    any mail server     resend: https://resend.com
EMAIL_DRIVER=console
EMAIL_FROM=TrackAJob <no-reply@trackajob.local>

# For EMAIL_DRIVER=mailgun
# MAILGUN_DOMAIN is the sending domain from the Mailgun dashboard, such as
# mg.yourdomain.com or sandbox123.mailgun.org. It is NOT the address in
# EMAIL_FROM, and the address in EMAIL_FROM must be on this domain.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# us (default) or eu. Using the wrong one fails with a bare 401.
MAILGUN_REGION=us

# For EMAIL_DRIVER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# For EMAIL_DRIVER=resend
RESEND_API_KEY=

# --- Bot protection ----------------------------------------------------
# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile, free).
# Leave both empty in development: the check is skipped locally.
# In production a missing secret makes signup return 503 rather than
# running unprotected.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# --- Links -------------------------------------------------------------
# Public origin used in verification and reset emails. Must be the real
# site URL in production or the emailed links will not work.
APP_BASE_URL=http://localhost:5173
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_MINUTES=60

# --- Login verification ------------------------------------------------
# A 6-digit code is emailed when a login comes from a country or device the
# account has not seen before. Set to false to disable the check.
LOGIN_CODE_ENABLED=true
LOGIN_CODE_MINUTES=10
